{
  "manifest_version": 2,
  "name": "EYMEN Browser Cosmetic Filter",
  "version": "1.0.0",
  "description": "Opt-in privacy-conscious visual removal of selected ad placeholders; no external lists or analytics.",
  "browser_specific_settings": {
    "gecko": {
      "id": "eymen-cosmetic@atasoyyazilim.com"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*/*"
      ],
      "js": [
        "cosmetic.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
